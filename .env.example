# CornBot Configuration Template

# Telegram Platform Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Set this to a local Telegram Bot API Server URL to increase file limits up to 2000MB
# TELEGRAM_API_URL=http://localhost:8081/bot

# Discord Platform Configuration (Future support)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# General Configuration
# Directory to store temporary downloads (will be created automatically)
DOWNLOAD_DIR=tmp

# Directory to store application logs and failure reports
LOG_DIR=logs

# Debug & Storage Options
# Enable detailed DEBUG logging (true/false)
DEBUG=false

# Keep temporary files after upload/processing (true/false)
KEEP_TMP_FILES=false

# Shell command template for downloading. 
# Use `{url}` and `{output_path}` as exact placeholders.
# By default, uses yt-dlp to download and output a safe mp4 file.
DOWNLOAD_COMMAND=yt-dlp -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" --merge-output-format mp4 -o "{output_path}" "{url}"

# Limits
MAX_CONCURRENT_DOWNLOADS=3
# Max upload size (50 for standard Telegram Bot API, up to 2000 for local server, 25 for Discord)
MAX_FILE_SIZE_MB=50
